NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# PIX is intentionally configured outside the repository. The key is public
# payment data, but the value must still be managed through Vercel environment
# variables for each deployment environment.
NEXT_PUBLIC_PIX_KEY=
NEXT_PUBLIC_PIX_MERCHANT_NAME=ALLVINO
NEXT_PUBLIC_PIX_MERCHANT_CITY=VITORIA

# Optional distributed rate limiting for Vercel instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
