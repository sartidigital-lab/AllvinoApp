NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Stone online payments run through Pagar.me Checkout. These values are
# server-only: never prefix them with NEXT_PUBLIC_ or commit their real values.
SUPABASE_SERVICE_ROLE_KEY=
PAGARME_SECRET_KEY=
# Test: https://sdx-api.pagar.me/core/v5
# Production: https://api.pagar.me/core/v5
PAGARME_BASE_URL=https://sdx-api.pagar.me/core/v5
# If omitted, the Pagar.me secret key is also used to validate X-Hub-Signature.
PAGARME_WEBHOOK_SIGNING_KEY=
PAGARME_PAYMENT_LINK_EXPIRES_IN_MINUTES=30

# Optional distributed rate limiting for Vercel instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Generate one persistent VAPID pair and configure these server-only variables
# in Vercel (Production, Preview and Development as appropriate).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
